{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudnav-worker",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  // Wrangler provisions these resources on the first deployment.
  // For existing resources, add the KV id and R2 bucket_name here.
  "kv_namespaces": [{ "binding": "CLOUDNAV_KV" }],
  "r2_buckets": [{ "binding": "CLOUDNAV_R2" }],
  // Set PASSWORD as a runtime Secret in the deployment wizard or Worker Settings.
  "dev": {
    "ip": "127.0.0.1",
    "port": 8788,
  },
}
